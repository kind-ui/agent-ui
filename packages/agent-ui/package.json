{
  "name": "@kind-ui/agent-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-operable AI components built on UI SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kind-ui/agent-ui.git",
    "directory": "packages/agent-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "default": "./dist/adapters/ai-sdk/index.js"
    },
    "./styles.css": "./dist/styles/agent-ui.css"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "node ../../scripts/check-ui-sdk-usage.mjs",
    "test:unit": "node --test \"tests/core/*.test.mjs\""
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ui-sdk/react": "0.1.0-beta.1",
    "@ui-sdk/web": "0.1.0-beta.1",
    "ai": "7.0.173"
  }
}
