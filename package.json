{
  "name": "agent-ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "npm run build -w @kind-ui/agent-ui",
    "lint": "biome check . && node scripts/check-ui-sdk-usage.mjs",
    "format": "biome check --write .",
    "typecheck": "node scripts/run-checks.mjs typecheck",
    "test:unit": "node scripts/run-checks.mjs test:unit",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "test:browser": "node scripts/run-checks.mjs test:browser",
    "check:package": "node scripts/run-checks.mjs check:package",
    "check:size": "node scripts/run-checks.mjs check:size",
    "build:registry": "node scripts/run-checks.mjs build:registry",
    "check:registry-consumers": "node scripts/run-checks.mjs check:registry-consumers",
    "check:fast": "node scripts/run-checks.mjs check:fast",
    "check:packed": "node scripts/run-checks.mjs check:packed",
    "check": "node scripts/run-checks.mjs check",
    "dev:docs": "node scripts/run-checks.mjs dev:docs",
    "build:docs": "node scripts/run-checks.mjs build:docs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
